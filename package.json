{
  "name": "duckuments-live-sync",
  "version": "0.1.0",
  "description": "Minimal self-hosted CouchDB live sync plugin for Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "couchdb",
    "pouchdb",
    "sync"
  ],
  "author": "duckuments",
  "license": "MIT",
  "dependencies": {
    "pouchdb-browser": "^9.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pouchdb-browser": "^6.1.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.6.0"
  }
}
